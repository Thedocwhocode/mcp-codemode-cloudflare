{
  "name": "mcp-codemode-cloudflare",
  "version": "1.0.0",
  "description": "Servidor MCP em Code Mode (search + execute) na Cloudflare, protegido pelo Access, para qualquer API com OpenAPI",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spec:trim": "node scripts/trim-spec.mjs",
    "spec:classify": "node scripts/classify.mjs",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [],
  "type": "module",
  "private": "true",
  "dependencies": {
    "@cloudflare/codemode": "^0.5.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "^0.30.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "license": "MIT"
}
